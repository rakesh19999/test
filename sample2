        }.AsQueryable();

        var imageSeries = new List<ImageSeries>
        {
            new ImageSeries { Id = 1, Name = "Image1", DefinedImageSeries = 1 },
            new ImageSeries { Id = 2, Name = "Image2", DefinedImageSeries = 2 },
        }.AsQueryable();

        // Mock DbSets
        _mockContext.Setup(c => c.Studies).Returns(DbSetMock.CreateMockSet(studies).Object);
        _mockContext.Setup(c => c.DefinedModalities).Returns(DbSetMock.CreateMockSet(definedModalities).Object);
        _mockContext.Setup(c => c.ImageProtocols).Returns(DbSetMock.CreateMockSet(imageProtocols).Object);
        _mockContext.Setup(c => c.DefinedImageSeries).Returns(DbSetMock.CreateMockSet(definedImageSeries).Object);
        _mockContext.Setup(c => c.ImageSeries).Returns(DbSetMock.CreateMockSet(imageSeries).Object);

        // Act
        var result = await _dataService.GetImageQCTask("someTaskId"); // Assuming it internally uses studyIdentifiers & modalityNames

        // Assert
        Assert.IsNotNull(result);
        Assert.IsTrue(result.Any());

        // Ensure only matching modalities (case-insensitive) are returned
        var modalitiesInResult = result.SelectMany(r => r.Modalities).Select(m => m.Modality).Distinct().ToList();

        CollectionAssert.AreEquivalent(new[] { "ct scan", "MRI" }, modalitiesInResult, 
