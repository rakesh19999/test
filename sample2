[Test]
public void GetModalities_ReturnsGroupedModalitiesWithImageSeriesAndAssignedSeries()
{
    // Arrange
    var disList = new List<DefinedModalityQcProtocol>
    {
        new DefinedModalityQcProtocol
        {
            DefinedModalityId = 1,
            DefinedModalities = "CT",
            ImageProcessingInstructions = "Instr1",
            DefinedImageSeriesId = 101,
            DefinedImageSeries = "PreGad-30-11 Axial"
        },
        new DefinedModalityQcProtocol
        {
            DefinedModalityId = 1,
            DefinedModalities = "CT",
            ImageProcessingInstructions = "Instr1",
            DefinedImageSeriesId = 102,
            DefinedImageSeries = "PostGad-30-11 Axial"
        }
    }.AsQueryable();

    var assignedSeriesResult = new List<AssignedSeriesEntity>
    {
        new AssignedSeriesEntity
        {
            Id = 201,
            Name = "Series A",
            DefinedImageSeriesId = 101
        },
        new AssignedSeriesEntity
        {
            Id = 202,
            Name = "Series B",
            DefinedImageSeriesId = 102
        }
    }.AsQueryable();

    // Act - simulate your method's LINQ logic
    var modalitiesQuery = disList
        .GroupBy(m => new { m.DefinedModalityId, m.DefinedModalities, m.ImageProcessingInstructions })
        .Select(group => new ModalityResponseQC
        {
            Id = group.Key.DefinedModalityId,
            Modality = group.Key.DefinedModalities,
            ProcessingInstructions = group.Key.ImageProcessingInstructions,
            ImageSeries = disList
                .Where(ing => ing.DefinedModalityId == group.Key.DefinedModalityId)
                .Select(ing => new ImageSeriesQC
                {
                    Id = ing.DefinedImageSeriesId.ToString(),
                    Name = ing.DefinedImageSeries,
                    AssignedSeries = assignedSeriesResult
                        .Where(asg => asg.DefinedImageSeriesId == ing.DefinedImageSeriesId)
                        .Select(asg => new AssignedSeries
                        {
                            Id = asg.Id,
                            Name = asg.Name
                        }).ToList()
                }).ToList()
        }).ToList();

    // Assert
    Assert.IsNotNull(modalitiesQuery);
    Assert.That(modalitiesQuery.Count, Is.EqualTo(1));
    Assert.That(modalitiesQuery[0].ImageSeries.Count, Is.EqualTo(2));
    Assert.That(modalitiesQuery[0].ImageSeries[0].AssignedSeries.Count, Is.EqualTo(1));
    Assert.That(modalitiesQuery[0].ImageSeries[0].AssignedSeries[0].Name, Is.EqualTo("Series A"));
}


[Test]
public void ModalitiesMapping_GroupsCorrectly_AndMapsImageSeriesWithAssignedSeries()
{
    // Arrange
    var queryResDIS = new List<dynamic>
    {
        new { DefinedModalityId = 1, DefinedModalityName = "CT" },
        new { DefinedModalityId = 2, DefinedModalityName = "MRI" },
        new { DefinedModalityId = 1, DefinedModalityName = "CT" }, // Duplicate for grouping test
    };

    var queryResImageSeries = new List<dynamic>
    {
        new { DefinedImageSeriesId = 100, DefinedImageSeries = "SeriesA", DefinedModalityId = 1 },
        new { DefinedImageSeriesId = 200, DefinedImageSeries = "SeriesB", DefinedModalityId = 2 },
        new { DefinedImageSeriesId = 100, DefinedImageSeries = "SeriesA", DefinedModalityId = 1 }, // Duplicate
    };

    var assignedSeriesResult = new List<AssignedSeries>
    {
        new AssignedSeries { Id = 100, Name = "AssignedA" },
        new AssignedSeries { Id = 200, Name = "AssignedB" },
    };

    // Act
    var modalities = queryResDIS
        .GroupBy(m => new { m.DefinedModalityId, m.DefinedModalityName })  // Grouping ensures uniqueness
        .Select(group => new QCTaskDto.ModalityResponseQC
        {
            Id = group.Key.DefinedModalityId,
            Modality = group.Key.DefinedModalityName,
            imageSeries = queryResImageSeries
                .Where(img => img.DefinedModalityId == group.Key.DefinedModalityId)
                .Select(img => new ImageSeriesQC
                {
                    Id = img.DefinedImageSeriesId.ToString(),
                    Name = img.DefinedImageSeries,
                    assignedSeries = assignedSeriesResult
                        .Where(asg => asg.Id == img.DefinedImageSeriesId)
                        .Select(asg => new AssignedSeries
                        {
                            Id = asg.Id,
                            Name = asg.Name
                        }).ToList()
                }).ToList()
        }).ToList();

    // Assert
    Assert.AreEqual(2, modalities.Count, "Should group into 2 unique modalities.");

    var ctModality = modalities.FirstOrDefault(m => m.Modality == "CT");
    Assert.IsNotNull(ctModality);
    Assert.AreEqual(1, ctModality.Id);
    Assert.AreEqual(2, ctModality.imageSeries.Count, "CT modality should have 2 image series mapped.");

    var firstSeries = ctModality.imageSeries.First();
    Assert.AreEqual("100", firstSeries.Id);
    Assert.AreEqual("SeriesA", firstSeries.Name);
    Assert.AreEqual(1, firstSeries.assignedSeries.Count, "Assigned series should be mapped correctly.");
    Assert.AreEqual("AssignedA", firstSeries.assignedSeries.First().Name);
}



