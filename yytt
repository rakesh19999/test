<Form.Check
  type="checkbox"
  checked={localData[rowIndex]?.isChecked || false}
  onChange={(e) => {
    const checked = e.target.checked;
    const updatedLocalData = [...localData];
    const row = updatedLocalData[rowIndex];

    // Update isChecked immediately in table
    updatedLocalData[rowIndex] = {
      ...row,
      isChecked: checked,
    };
    setLocalData(updatedLocalData);

    // Now, prepare updated selectedRows
    let updatedSelection = [...selectedRows];

    const alreadyExisting = updatedSelection.find(
      (r) => r.imageSeriesQCCheckId === row.imageSeriesQCCheckId
    );

    if (checked) {
      // If checkbox checked
      if (alreadyExisting) {
        alreadyExisting.isDeselected = false;
      } else {
        updatedSelection.push({
          ...row,
          isDeselected: false,
        });
      }
    } else {
      // If checkbox unchecked
      if (alreadyExisting) {
        if (row.isPreSelected) {
          // If it was a pre-selected row, mark it as deselected
          alreadyExisting.isDeselected = true;
          alreadyExisting.isChecked = false;
        } else {
          // If it was a newly selected row, remove it
          updatedSelection = updatedSelection.filter(
            (r) => r.imageSeriesQCCheckId !== row.imageSeriesQCCheckId
          );
        }
      } else {
        if (row.isPreSelected) {
          updatedSelection.push({
            ...row,
            isDeselected: true,
            isChecked: false,
          });
        }
      }
    }

    // Set updated selectedRows
    setSelectedRows(updatedSelection);

    // Optional if you need to call
    onSelectionChange?.(updatedSelection);
    onAnyCheckChange?.();
  }}
  disabled={isPublished}
/>
