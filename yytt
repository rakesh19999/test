const resetDicom = async () => {
  const updatedSelection = selectedRows.map((row) => {
    if (row.isPreselected) {
      // If it was preselected earlier — create deselected object
      return {
        ...row,
        isDeselected: true,
        isChecked: false,
      };
    }
    // If it was newly selected (not preselected), we don't need to keep it
    return null;
  }).filter(Boolean); // Remove nulls

  const resetData = PCData.map((item) => ({
    ...item,
    isChecked: false,
    checkbox: false,
    expectedValue: "",
    checkCondition: "",
  }));

  setFilteredData(resetData);
  setPCData(resetData);
  setTableKey((prev) => prev + 1);

  setSelectedRows(updatedSelection);
};
