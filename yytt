const handleRowCheckChange = (row: any, isChecked: boolean) => {
  setSelectedChecks((prevSelected) => {
    const existingRow = prevSelected.find((r) => r.imageSeriesQCCheckId === row.imageSeriesQCCheckId);

    if (isChecked) {
      if (existingRow) {
        return prevSelected.map((r) =>
          r.imageSeriesQCCheckId === row.imageSeriesQCCheckId
            ? { ...r, isDeselected: false }
            : r
        );
      } else {
        return [...prevSelected, { ...row, isDeselected: false }];
      }
    } else {
      if (existingRow) {
        return prevSelected.map((r) =>
          r.imageSeriesQCCheckId === row.imageSeriesQCCheckId
            ? { ...r, isDeselected: true, isChecked: false }
            : r
        );
      } else {
        return [...prevSelected, { ...row, isDeselected: true, isChecked: false }];
      }
    }
  });
};
