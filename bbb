// QCFormBasicDetails.test.tsx
import React from "react";
import { render, screen } from "@testing-library/react";
import { QCFormBasicDetails } from "./QCFormBasicDetails"; // adjust path as needed

// Mock OverlayToggle component if it's from an external library
jest.mock("@cip-portal/cip-shared-ui-lib", () => ({
  OverlayToggle: ({ value, children }: { value: string; children: React.ReactNode }) => (
    <div data-testid={`overlay-${value}`}>{children}</div>
  ),
}));

describe("QCFormBasicDetails - qcTaskStatus logic", () => {
  it("renders correct icon for 'new' task status", () => {
    const props = {
      qcformBasicDetails: [["taskStatus", "new"]],
      qcFormData: {},
      helpfulLinksQC: [],
    };

    render(<QCFormBasicDetails {...props} />);
    const statusDiv = screen.getByTestId("overlay-new").querySelector("#new");

    expect(statusDiv).toBeInTheDocument();
    expect(statusDiv).toHaveClass("img-qc-new-status");
  });

  it("renders correct icon for 'in progress' task status", () => {
    const props = {
      qcformBasicDetails: [["taskStatus", "in progress"]],
      qcFormData: {},
      helpfulLinksQC: [],
    };

    render(<QCFormBasicDetails {...props} />);
    const statusDiv = screen.getByTestId("overlay-in progress").querySelector("#inprogress");

    expect(statusDiv).toBeInTheDocument();
    expect(statusDiv).toHaveClass("img-qc-inprogress-status");
  });

  it("renders fallback span for unknown status", () => {
    const props = {
      qcformBasicDetails: [["taskStatus", "random"]],
      qcFormData: {},
      helpfulLinksQC: [],
    };

    render(<QCFormBasicDetails {...props} />);
    expect(screen.getByText("random")).toBeInTheDocument();
  });
});
