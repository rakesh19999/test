// ProtocolComplianceQCChecks.test.tsx
import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import ProtocolComplianceQCChecks from './ProtocolComplianceQCChecks';
import { useMsal } from '@azure/msal-react';
import * as api from '../../services/api';
import * as tokenUtil from '../../common/AccessToken';

// Mock MSAL
jest.mock('@azure/msal-react', () => ({
  useMsal: jest.fn(),
}));

// Mock API modules
jest.mock('../../services/api');
jest.mock('../../common/AccessToken');

describe('ProtocolComplianceQCChecks', () => {
  const mockHandleClose = jest.fn();
  const mockOnSave = jest.fn();

  const defaultProps = {
    title: 'QC Checks',
    id: 'test',
    show: true,
    handleClose: mockHandleClose,
    modalityId: 'modality123',
    studyId: 456,
    listKeyFunc: jest.fn(),
    refreshKey: 0,
    studyIdentifier: 'study123',
    definedModalityId: 'mod123',
    definedAnatomyId: 'anat456',
    definedImageSeriesId: 'img789',
    checkLevel: 'Modality',
    status: 'Active',
    onSave: mockOnSave,
  };

  beforeEach(() => {
    (useMsal as jest.Mock).mockReturnValue({
      instance: {},
      inProgress: 'none',
    });

    (tokenUtil.GetAccessToken as jest.Mock).mockResolvedValue('mockToken');

    (api.fetchPCCheckList as jest.Mock).mockResolvedValue({
      pcCheckList: [
        { id: 1, dicomTag: '0010,0010', name: 'Patient Name' },
        { id: 2, dicomTag: '0010,0020', name: 'Patient ID' },
      ],
      checkConditionsList: ['Equals', 'Contains'],
    });
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  it('renders modal with title and fetches QC check list', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);

    expect(screen.getByText('QC Checks')).toBeInTheDocument();

    await waitFor(() => {
      expect(api.fetchPCCheckList).toHaveBeenCalledWith(
        'mockToken',
        'mod123', // from checkLevel = 'Modality'
        'modality123',
        456,
        'Modality'
      );
    });
  });

  it('calls handleClose when Cancel is clicked', () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    const cancelBtn = screen.getByText('Cancel');
    fireEvent.click(cancelBtn);
    expect(mockHandleClose).toHaveBeenCalled();
  });

  it('filters results on Search click', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Patient Name');

    const searchInput = screen.getByPlaceholderText('Search...');
    fireEvent.change(searchInput, { target: { value: 'Patient ID' } });

    const searchBtn = screen.getByRole('button', { name: /search/i });
    fireEvent.click(searchBtn);

    await waitFor(() => {
      expect(screen.queryByText('Patient Name')).not.toBeInTheDocument();
      expect(screen.getByText('Patient ID')).toBeInTheDocument();
    });
  });

  it('clears search on Clear click', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Patient Name');

    const clearBtn = screen.getByText('Clear');
    fireEvent.click(clearBtn);

    expect(screen.getByPlaceholderText('Search...')).toHaveValue('');
  });

  // Add test for handleSave once implemented
});
