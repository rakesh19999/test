import { render, screen, act, waitFor } from '@testing-library/react';
import { SiteComments } from './SiteComments'; // Adjust the import as necessary
import { Constants } from "../../common/constants";

// Mock the image series data
const mockImageSeries = {
  imageseries: [
    {
      patientComments: "Comment 1",
      seriesInstanceUID: "123"
    },
    {
      patientComments: "Comment 2",
      seriesInstanceUID: "456"
    }
  ]
};

const mockImgSeries = {
  imageseries: [
    {
      patientComments: "Test comment",
      seriesInstanceUID: "789"
    }
  ]
};

describe('SiteComments Component', () => {
  test('should render SiteComments component correctly', async () => {
    render(<SiteComments imgSeries={mockImgSeries} ingSeries={mockImageSeries} />);
    
    // Check if the Accordion header is rendered
    expect(screen.getByText('Site Comments')).toBeInTheDocument();
  });

  test('should display correct patient comments when imgSeries changes', async () => {
    const { rerender } = render(<SiteComments imgSeries={mockImgSeries} ingSeries={mockImageSeries} />);
    
    // Initially check for the default state
    expect(screen.getByRole('textbox').value).toBe(Constants.nositeCommentsFound);

    // Change imgSeries
    const newImgSeries = {
      imageseries: [
        {
          patientComments: "Updated Test comment",
          seriesInstanceUID: "789"
        }
      ]
    };
    rerender(<SiteComments imgSeries={newImgSeries} ingSeries={mockImageSeries} />);
    
    // Wait for the component to update
    await waitFor(() => expect(screen.getByRole('textbox').value).toBe("Updated Test comment"));
  });

  test('should display multiple comments correctly when comments differ', async () => {
    const { rerender } = render(<SiteComments imgSeries={mockImgSeries} ingSeries={mockImageSeries} />);
    
    const newImgSeries = {
      imageseries: [
        {
          patientComments: "Updated comment 1",
          seriesInstanceUID: "789"
        },
        {
          patientComments: "Updated comment 2",
          seriesInstanceUID: "101"
        }
      ]
    };
    rerender(<SiteComments imgSeries={newImgSeries} ingSeries={mockImageSeries} />);
    
    await waitFor(() => expect(screen.getByRole('textbox').value).toBe("Updated comment 1\nUpdated comment 2"));
  });

  test('should call callback function when provided', async () => {
    const callbackMock = jest.fn();
    
    render(<SiteComments imgSeries={mockImgSeries} ingSeries={mockImageSeries} callbackFunc={callbackMock} />);
    
    // Check that the callback function is not called initially
    expect(callbackMock).not.toHaveBeenCalled();
    
    // Simulate any action that triggers callback
    act(() => {
      // Add the trigger for the callback here if any
    });

    // Ensure the callback function is called
    expect(callbackMock).toHaveBeenCalledTimes(1);
  });
});
