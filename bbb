import { fetchStudyData } from "./YourFile"; // adjust path
import axios from "axios";

jest.mock("axios");
const mockedAxios = axios as jest.Mocked<typeof axios>;

describe("fetchStudyData", () => {
  beforeEach(() => {
    global.fetch = jest.fn()
      .mockResolvedValueOnce({
        json: async () => ({ DATA_QC_HOST: "http://localhost:3000" }),
      } as Response)
      .mockResolvedValueOnce({
        json: async () => ({ DATA_QC_API_URL: "http://api.test.com" }),
      } as Response);

    mockedAxios.get.mockResolvedValue({ data: { studyName: "TestStudy" } });
  });

  it("fetches study data successfully", async () => {
    const result = await fetchStudyData("test-token", "123");

    expect(global.fetch).toHaveBeenCalledTimes(2);
    expect(mockedAxios.get).toHaveBeenCalledWith(
      "http://api.test.com/studyconfig/123",
      {
        headers: {
          Authorization: "Bearer test-token",
        },
      }
    );
    expect(result).toEqual({ studyName: "TestStudy" });
  });

  it("handles fetch or axios failure", async () => {
    mockedAxios.get.mockRejectedValue(new Error("Network error"));
    const result = await fetchStudyData("test-token", "123");
    expect(result).toBeUndefined(); // since the catch block has no return
  });
});
