import axios from "axios";
import { fetchPCCheckList } from "../services/ProtocolComplianceService";

jest.mock("axios");
const mockedAxios = axios as jest.Mocked<typeof axios>;

describe("fetchPCCheckList", () => {
  beforeEach(() => {
    global.fetch = jest.fn()
      .mockResolvedValueOnce({
        json: jest.fn().mockResolvedValue({ DATA_QC_HOST: "http://host.com" }),
      } as Response)
      .mockResolvedValueOnce({
        json: jest.fn().mockResolvedValue({
          DATA_QC_API_URL: "http://api.com",
        }),
      } as Response);
  });

  it("returns data on success", async () => {
    mockedAxios.get.mockResolvedValueOnce({ data: { results: [] } });

    const data = await fetchPCCheckList(
      "token123",
      "cl1",
      "mod1",
      123,
      "Image"
    );

    expect(data).toEqual({ results: [] });

    expect(mockedAxios.get).toHaveBeenCalledWith(
      "http://api.com/GetProtocolComplianceQCCheckList?modalityId=mod1&checkLevelId=cl1&studyId=123&checkLevel=Image",
      { headers: { Authorization: "Bearer token123" } }
    );
  });

  it("logs and returns nothing when no access token", async () => {
    const result = await fetchPCCheckList("", "cl1", "mod1", 123, "Image");
    expect(result).toBeUndefined();
  });

  it("throws an error on axios failure", async () => {
    mockedAxios.get.mockRejectedValueOnce(new Error("Network Error"));

    await expect(
      fetchPCCheckList("token123", "cl1", "mod1", 123, "Image")
    ).rejects.toThrow("Network Error");
  });
});
