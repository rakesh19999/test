import { render, waitFor } from '@testing-library/react';
import ProtocolComplianceQCChecks from './ProtocolComplianceQCChecks';
import { fetchPCCheckList } from 'services/api';
import { GetAccessToken } from 'utils/token';

describe('ProtocolComplianceQCChecks - InvokeQCCheckListApi', () => {
  const mockApiResponse = {
    pcCheckList: [{ id: 1, name: 'QC 1' }],
    checkConditionsList: ['Condition A', 'Condition B'],
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should call fetchPCCheckList, set data and handle loading state', async () => {
    (GetAccessToken as jest.Mock).mockResolvedValue('fake-token');
    (fetchPCCheckList as jest.Mock).mockResolvedValue(mockApiResponse);

    const { getByText } = render(
      <ProtocolComplianceQCChecks isOpen={true} onClose={() => {}} />
    );

    // Wait for checklist data to render
    await waitFor(() => {
      expect(getByText('QC 1')).toBeInTheDocument();
    });

    expect(GetAccessToken).toHaveBeenCalled();
    expect(fetchPCCheckList).toHaveBeenCalledWith(
      'fake-token',
      expect.any(String), // checkLevelId
      expect.any(String), // modalityId
      expect.any(String), // studyId
      expect.any(String)  // checkLevel
    );
  });

  it('should handle API error and still stop loading', async () => {
    (GetAccessToken as jest.Mock).mockResolvedValue('fake-token');
    (fetchPCCheckList as jest.Mock).mockRejectedValue(new Error('API Error'));

    const consoleErrorSpy = jest.spyOn(console, 'error').mockImplementation(() => {});

    render(<ProtocolComplianceQCChecks isOpen={true} onClose={() => {}} />);

    await waitFor(() => {
      expect(consoleErrorSpy).toHaveBeenCalledWith(
        'Error fetching Protocol Compliance Check Per Modality List',
        expect.any(Error)
      );
    });

    expect(GetAccessToken).toHaveBeenCalled();
    expect(fetchPCCheckList).toHaveBeenCalled();
    consoleErrorSpy.mockRestore();
  });
});
