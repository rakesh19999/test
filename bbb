import React from 'react';
import { render, screen, fireEvent } from '@testing-library/react';
import QCFormSubmit from '../QCFormSubmit';

describe('QCFormSubmit Component', () => {
  const defaultProps = {
    isChecked: false,
    handleCheckboxChange: jest.fn(),
    isReadOnly: false,
    qcstatus: '',
    closeButton: jest.fn(),
    handleSaveButtonClick: jest.fn(),
    handleQCStatusButtonClick: jest.fn(),
    taskId: '123',
  };

  it('renders checkbox and handles change', () => {
    render(<QCFormSubmit {...defaultProps} />);
    const checkbox = screen.getByRole('checkbox');
    expect(checkbox).toBeInTheDocument();
    fireEvent.click(checkbox);
    expect(defaultProps.handleCheckboxChange).toHaveBeenCalled();
  });

  it('disables checkbox if taskId is missing or isReadOnly is true', () => {
    render(<QCFormSubmit {...defaultProps} taskId={''} isReadOnly={true} />);
    const checkbox = screen.getByRole('checkbox');
    expect(checkbox).toBeDisabled();
  });

  it('calls closeButton on Cancel click', () => {
    render(<QCFormSubmit {...defaultProps} />);
    const cancelBtn = screen.getByText(/cancel/i);
    fireEvent.click(cancelBtn);
    expect(defaultProps.closeButton).toHaveBeenCalled();
  });

  it('renders Save button and handles click', () => {
    render(<QCFormSubmit {...defaultProps} qcstatus="something" />);
    const saveBtn = screen.getByText(/save/i);
    expect(saveBtn).toBeInTheDocument();
    fireEvent.click(saveBtn);
    expect(defaultProps.handleSaveButtonClick).toHaveBeenCalledWith('123');
  });

  it('renders QC Not Required button and handles click', () => {
    render(<QCFormSubmit {...defaultProps} qcstatus="qc not required" />);
    const notReqBtn = screen.getByText(/qc not required/i);
    fireEvent.click(notReqBtn);
    expect(defaultProps.handleQCStatusButtonClick).toHaveBeenCalledWith('123', 2);
  });

  it('renders QC Failed button and handles click', () => {
    render(<QCFormSubmit {...defaultProps} qcstatus="qc failed" />);
    const failedBtn = screen.getByText(/qc failed/i);
    fireEvent.click(failedBtn);
    expect(defaultProps.handleQCStatusButtonClick).toHaveBeenCalledWith('123', 0);
  });

  it('renders QC Passed button and handles click', () => {
    render(<QCFormSubmit {...defaultProps} qcstatus="qc passed" />);
    const passedBtn = screen.getByText(/qc passed/i);
    fireEvent.click(passedBtn);
    expect(defaultProps.handleQCStatusButtonClick).toHaveBeenCalledWith('123', 1);
  });

  it('disables all QC buttons when isReadOnly is true or isChecked is true', () => {
    render(<QCFormSubmit {...defaultProps} isReadOnly={true} isChecked={true} qcstatus="qc passed" />);
    const passedBtn = screen.getByText(/qc passed/i);
    expect(passedBtn).toBeDisabled();
  });
});
