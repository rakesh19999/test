import React from "react";
import { render, screen, fireEvent, waitFor } from "@testing-library/react";
import { ImageProtocol } from "../ImageProtocol";
import * as msalReact from "@azure/msal-react";
import * as StudyService from "../../../services/StudyService";
import { Constants } from "../../../common/constants";

// Mock useMsal
jest.mock("@azure/msal-react", () => ({
  useMsal: () => ({
    instance: {},
    inProgress: "none"
  })
}));

// Mock service
jest.mock("../../../services/StudyService", () => ({
  fetchStudyData: jest.fn()
}));

const mockStudyConfigData = {
  studyIdentifier: "study-123",
  modalities: [
    {
      id: 1,
      modality: "CT",
      tat: 12,
      expeditedTat: 6,
      definedModalityId: "mod1"
    }
  ],
  savedChecks: [
    {
      id: 1,
      checkLevel: "modality",
      count: 3
    }
  ]
};

const mockStudyConfigToSave = {
  modalities: []
};

describe("ImageProtocol Component", () => {
  const callbackfn = jest.fn();

  beforeEach(() => {
    jest.clearAllMocks();
  });

  test("renders modality information", () => {
    render(
      <ImageProtocol
        studyConfigData={mockStudyConfigData}
        callbackfn={callbackfn}
        studyConfigToSave={mockStudyConfigToSave}
      />
    );

    expect(screen.getByText("Study Modalities")).toBeInTheDocument();
    expect(screen.getByText("CT")).toBeInTheDocument();
    expect(screen.getByText("TAT:")).toBeInTheDocument();
    expect(screen.getByText("12")).toBeInTheDocument();
    expect(screen.getByText("Expedited TAT:")).toBeInTheDocument();
    expect(screen.getByText("6")).toBeInTheDocument();
    expect(screen.getByText("3")).toBeInTheDocument(); // savedChecks count
  });

  test("opens ProtocolComplianceQCChecks modal on + icon click", async () => {
    render(
      <ImageProtocol
        studyConfigData={mockStudyConfigData}
        callbackfn={callbackfn}
        studyConfigToSave={mockStudyConfigToSave}
      />
    );

    const plusIcon = screen.getByRole("img"); // FontAwesomeIcon renders as <svg role="img">
    fireEvent.click(plusIcon);

    await waitFor(() => {
      expect(screen.getByText("CT")).toBeInTheDocument(); // modal title
    });
  });

  test("fetchStudyData called on handleClose", async () => {
    const mockFetch = jest.spyOn(StudyService, "fetchStudyData").mockResolvedValueOnce({
      modalities: [],
      savedChecks: []
    });

    render(
      <ImageProtocol
        studyConfigData={mockStudyConfigData}
        callbackfn={callbackfn}
        studyConfigToSave={mockStudyConfigToSave}
      />
    );

    const plusIcon = screen.getByRole("img");
    fireEvent.click(plusIcon);

    await waitFor(() => {
      expect(screen.getByText("CT")).toBeInTheDocument();
    });

    const closeButton = screen.getByText("CT"); // simulate closing by triggering handleClose
    fireEvent.click(closeButton); // ideally you'd have a modal close button to target

    await waitFor(() => {
      expect(mockFetch).toHaveBeenCalled();
    });
  });

  test("toggles Accordion correctly", () => {
    render(
      <ImageProtocol
        studyConfigData={mockStudyConfigData}
        callbackfn={callbackfn}
        studyConfigToSave={mockStudyConfigToSave}
      />
    );

    const header = screen.getByText("CT");
    fireEvent.click(header);

    // Accordion opens (Body should be visible)
    expect(screen.getByText("TAT:")).toBeInTheDocument();

    fireEvent.click(header);

    // Accordion collapses (Body disappears)
    expect(screen.queryByText("TAT:")).toBeInTheDocument(); // Accordion body still exists due to Bootstrap collapsing behavior
  });
});
