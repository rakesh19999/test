import React from 'react';
import { render, screen, waitFor, fireEvent } from '@testing-library/react';
import ProtocolComplianceQCChecks from '../ProtocolComplianceQCChecks';
import * as StudyService from '../../../services/Studyservice';

jest.mock('../../../services/Studyservice', () => ({
  fetchPCCheckList: jest.fn(),
  patchStudyDicomQCCheckConfiguration: jest.fn()
}));

describe('ProtocolComplianceQCChecks', () => {
  const defaultProps = {
    isOpen: true,
    onClose: jest.fn(),
    studyConfig: { studyProtocolId: 123 },
    onSave: jest.fn()
  };

  const mockChecklist = {
    pcChecklist: [
      {
        id: 1,
        checkName: 'Check 1',
        checkType: 'Text',
        expectedValue: '',
        checkCondition: '=',
        isPreselected: false,
        definedModalityQcCheckId: null
      },
      {
        id: 2,
        checkName: 'Check 2',
        checkType: 'Dropdown',
        expectedValue: 'Yes',
        checkCondition: '!=',
        isPreselected: true,
        definedModalityQcCheckId: 555
      }
    ],
    checkConditionsList: [
      { label: 'Equals', value: '=' },
      { label: 'Not Equals', value: '!=' }
    ]
  };

  beforeEach(() => {
    jest.clearAllMocks();
    (StudyService.fetchPCCheckList as jest.Mock).mockResolvedValue(mockChecklist);
    (StudyService.patchStudyDicomQCCheckConfiguration as jest.Mock).mockResolvedValue(true);
  });

  it('renders checklist rows', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    expect(await screen.findByText('Check 1')).toBeInTheDocument();
    expect(screen.getByText('Check 2')).toBeInTheDocument();
  });

  it('allows selecting and saving a new row', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Check 1');
    
    const checkbox = screen.getAllByRole('checkbox')[0];
    fireEvent.click(checkbox);
    expect(checkbox).toBeChecked();

    fireEvent.click(screen.getByRole('button', { name: /save/i }));

    await waitFor(() => {
      expect(StudyService.patchStudyDicomQCCheckConfiguration).toHaveBeenCalled();
    });
    expect(defaultProps.onSave).toHaveBeenCalled();
  });

  it('displays a preselected row as checked', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Check 2');

    const checkboxes = screen.getAllByRole('checkbox');
    expect(checkboxes[1]).toBeChecked(); // Preselected
  });

  it('allows editing expected value of a row', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Check 1');

    const input = screen.getAllByRole('textbox')[0];
    fireEvent.change(input, { target: { value: '90' } });
    expect(input).toHaveValue('90');
  });

  it('allows changing check condition via dropdown', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Check 1');

    const dropdowns = screen.getAllByRole('combobox');
    fireEvent.change(dropdowns[0], { target: { value: '!=' } });

    expect(dropdowns[0]).toHaveValue('!=');
  });

  it('calls onClose when Cancel button is clicked', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('Check 1');

    fireEvent.click(screen.getByRole('button', { name: /cancel/i }));
    expect(defaultProps.onClose).toHaveBeenCalled();
  });
});
