import React from 'react';
import { render, fireEvent, screen, waitFor } from '@testing-library/react';
import ProtocolComplianceQCChecks from './ProtocolComplianceQCChecks';
import { useMsal } from '@azure/msal-react';
import * as StudyService from '../../services/Studyservice';
import { GetAccessToken } from '../../common/AccessToken';
import { ToastContainer } from 'react-toastify';

jest.mock('@azure/msal-react');
jest.mock('../../services/Studyservice');
jest.mock('../../common/AccessToken');

const mockPcChecklist = [
  {
    imageSeriesQCCheckId: 1,
    dicomTag: "0010,0010",
    name: "PatientName",
    description: "Check for patient name",
    isEditable: true,
    isChecked: false,
    checkCondition: "e",
    expectedValue: "",
    isSelected: false,
    definedQcCheckId: "QCID123",
    attributeId: 123
  }
];

const mockConditionsList = ["=", "<", ">"];

describe('ProtocolComplianceQCChecks', () => {
  const defaultProps = {
    title: 'Head MRI',
    id: 'modal-1',
    show: true,
    handleClose: jest.fn(),
    modalityId: 'mod1',
    studyId: 123,
    listkeyFunc: jest.fn(),
    refreshkey: 1,
    studyIdentifier: 'StudyABC',
    definedModalityId: 'mod1',
    checkLevel: 'Modality',
    status: 'Draft',
    onSave: jest.fn(),
    definedAnatomyId: 'anat1',
    definedImageSeriesId: 'series1'
  };

  beforeEach(() => {
    (useMsal as jest.Mock).mockReturnValue({
      instance: {},
      inProgress: 'none',
    });

    (GetAccessToken as jest.Mock).mockResolvedValue('mockAccessToken');

    (StudyService.fetchPCCheckList as jest.Mock).mockResolvedValue({
      pcChecklist: mockPcChecklist,
      checkConditionsList: mockConditionsList
    });

    (StudyService.patchStudyDicomQCCheckConfiguration as jest.Mock).mockResolvedValue(true);
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  it('renders modal with title and checklist rows', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    expect(await screen.findByText('Protocol Compliance')).toBeInTheDocument();
    expect(await screen.findByText('PatientName')).toBeInTheDocument();
  });

  it('allows selecting a row and saving it', async () => {
    render(
      <>
        <ProtocolComplianceQCChecks {...defaultProps} />
        <ToastContainer />
      </>
    );

    const checkbox = await screen.findByRole('checkbox');
    fireEvent.click(checkbox);

    const expectedValueInput = screen.getByDisplayValue('');
    fireEvent.change(expectedValueInput, { target: { value: 'TestValue' } });

    const select = screen.getByDisplayValue('e');
    fireEvent.change(select, { target: { value: '=' } });

    const saveButton = screen.getByText('Save');
    fireEvent.click(saveButton);

    await waitFor(() =>
      expect(StudyService.patchStudyDicomQCCheckConfiguration).toHaveBeenCalled()
    );
  });

  it('shows toast error when trying to save without checkCondition', async () => {
    render(
      <>
        <ProtocolComplianceQCChecks {...defaultProps} />
        <ToastContainer />
      </>
    );

    const checkbox = await screen.findByRole('checkbox');
    fireEvent.click(checkbox);

    const saveButton = screen.getByText('Save');
    fireEvent.click(saveButton);

    await screen.findByText(/Please select check condition/i);
  });

  it('filters rows on search', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('PatientName');

    const input = screen.getByPlaceholderText('Search');
    fireEvent.change(input, { target: { value: 'Patient' } });

    const searchButton = screen.getByRole('button', { name: /search/i });
    fireEvent.click(searchButton);

    expect(await screen.findByText('PatientName')).toBeInTheDocument();
  });

  it('clears search and restores rows', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    await screen.findByText('PatientName');

    const input = screen.getByPlaceholderText('Search');
    fireEvent.change(input, { target: { value: 'Patient' } });

    const searchButton = screen.getByRole('button', { name: /search/i });
    fireEvent.click(searchButton);

    const clearButton = await screen.findByText('Clear');
    fireEvent.click(clearButton);

    expect(await screen.findByText('PatientName')).toBeInTheDocument();
  });

  it('calls handleClose when modal is closed', async () => {
    render(<ProtocolComplianceQCChecks {...defaultProps} />);
    const closeButton = await screen.findByLabelText('Close');
    fireEvent.click(closeButton);
    expect(defaultProps.handleClose).toHaveBeenCalled();
  });
});
