import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import ProtocolComplianceQCChecks from './ProtocolComplianceQCChecks';
import * as api from 'services/api'; // mock this

jest.mock('services/api');

const mockData = [
  {
    qcChecklistId: 1,
    qcCheckName: 'Check A',
    condition: 'Equals',
  },
  {
    qcChecklistId: 2,
    qcCheckName: 'Check B',
    condition: 'Contains',
  },
];

describe('ProtocolComplianceQCChecks', () => {
  const setup = (overrides = {}) => {
    const props = {
      showModal: true,
      onClose: jest.fn(),
      selectedQcCheckIds: [1],
      studyId: 1,
      modality: 'CT',
      definedModalityQcCheckId: 10,
      setDefinedModalityQcCheckId: jest.fn(),
      ...overrides,
    };

    render(<ProtocolComplianceQCChecks {...props} />);
    return props;
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should fetch QC checklist on mount', async () => {
    (api.getQCChecklist as jest.Mock).mockResolvedValue(mockData);

    setup();

    await waitFor(() => {
      expect(api.getQCChecklist).toHaveBeenCalled();
    });

    expect(screen.getByText('Check A')).toBeInTheDocument();
    expect(screen.getByText('Check B')).toBeInTheDocument();
  });

  it('should handle checkbox change', async () => {
    (api.getQCChecklist as jest.Mock).mockResolvedValue(mockData);
    setup();

    const checkbox = await screen.findByLabelText('Check B');
    fireEvent.click(checkbox);

    expect(checkbox).toBeChecked();
  });

  it('should handle condition change', async () => {
    (api.getQCChecklist as jest.Mock).mockResolvedValue(mockData);
    setup();

    const dropdown = await screen.findByTestId('condition-select-1');
    fireEvent.change(dropdown, { target: { value: 'NotEquals' } });

    expect(dropdown).toHaveValue('NotEquals');
  });

  it('should call handleSave and update definedModalityQcCheckId', async () => {
    (api.getQCChecklist as jest.Mock).mockResolvedValue(mockData);
    (api.saveQCChecks as jest.Mock).mockResolvedValue({ definedModalityQcCheckId: 99 });

    const setDefinedModalityQcCheckId = jest.fn();
    const onClose = jest.fn();

    setup({ setDefinedModalityQcCheckId, onClose });

    const saveButton = await screen.findByText('Save');
    fireEvent.click(saveButton);

    await waitFor(() => {
      expect(api.saveQCChecks).toHaveBeenCalled();
      expect(setDefinedModalityQcCheckId).toHaveBeenCalledWith(99);
      expect(onClose).toHaveBeenCalled();
    });
  });

  it('should handle reset', async () => {
    (api.getQCChecklist as jest.Mock).mockResolvedValue(mockData);
    setup();

    const checkbox = await screen.findByLabelText('Check A');
    fireEvent.click(checkbox);

    const resetButton = screen.getByText('Reset');
    fireEvent.click(resetButton);

    // After reset, checkbox should be in original state
    expect(checkbox).not.toBeChecked(); // assuming Check A was initially unchecked
  });

  it('should close modal on cancel', async () => {
    const onClose = jest.fn();
    setup({ onClose });

    const cancelButton = screen.getByText('Cancel');
    fireEvent.click(cancelButton);

    expect(onClose).toHaveBeenCalled();
  });
});
