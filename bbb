import React from 'react';
import { render, fireEvent, screen } from '@testing-library/react';
import QCFormSubmit from '../QCFormSubmit'; // adjust the import path as needed
import '@testing-library/jest-dom';

describe('QCFormSubmit', () => {
  const baseProps = {
    isChecked: false,
    isReadOnly: false,
    qcstatus: '',
    taskId: '123',
    closeButton: jest.fn(),
    handleSaveButtonClick: jest.fn(),
    handleCheckboxChange: jest.fn(),
    handleQCStatusButtonClick: jest.fn(),
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('renders checkbox and triggers change handler', () => {
    render(<QCFormSubmit {...baseProps} />);
    const checkbox = screen.getByRole('checkbox');
    expect(checkbox).toBeInTheDocument();

    fireEvent.click(checkbox);
    expect(baseProps.handleCheckboxChange).toHaveBeenCalled();
  });

  it('disables all actions when isReadOnly is true', () => {
    render(<QCFormSubmit {...baseProps} isReadOnly={true} />);
    expect(screen.getByRole('checkbox')).toBeDisabled();
  });

  it('calls closeButton when Cancel is clicked', () => {
    render(<QCFormSubmit {...baseProps} />);
    fireEvent.click(screen.getByText(/cancel/i));
    expect(baseProps.closeButton).toHaveBeenCalled();
  });

  it('renders Save button and triggers handleSaveButtonClick', () => {
    render(<QCFormSubmit {...baseProps} qcstatus="anything" />);
    const saveBtn = screen.getByText(/save/i);
    expect(saveBtn).toBeInTheDocument();
    fireEvent.click(saveBtn);
    expect(baseProps.handleSaveButtonClick).toHaveBeenCalledWith('123');
  });

  it('renders QC Not Required button and triggers handler', () => {
    render(<QCFormSubmit {...baseProps} qcstatus="qc not required" />);
    const notRequiredBtn = screen.getByText(/qc not required/i);
    expect(notRequiredBtn).toBeInTheDocument();
    fireEvent.click(notRequiredBtn);
    expect(baseProps.handleQCStatusButtonClick).toHaveBeenCalledWith('123', 2);
  });

  it('renders QC Failed button and triggers handler', () => {
    render(<QCFormSubmit {...baseProps} qcstatus="qc failed" />);
    const failedBtn = screen.getByText(/qc failed/i);
    expect(failedBtn).toBeInTheDocument();
    fireEvent.click(failedBtn);
    expect(baseProps.handleQCStatusButtonClick).toHaveBeenCalledWith('123', 0);
  });

  it('renders QC Passed button and triggers handler', () => {
    render(<QCFormSubmit {...baseProps} qcstatus="qc passed" />);
    const passedBtn = screen.getByText(/qc passed/i);
    expect(passedBtn).toBeInTheDocument();
    fireEvent.click(passedBtn);
    expect(baseProps.handleQCStatusButtonClick).toHaveBeenCalledWith('123', 1);
  });

  it('disables QC buttons when isChecked is true', () => {
    render(<QCFormSubmit {...baseProps} isChecked={true} qcstatus="qc failed" />);
    const failedBtn = screen.getByText(/qc failed/i);
    expect(failedBtn).toBeDisabled();
  });
});
