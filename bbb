// QCFormBasicDetails.test.tsx

import React from "react";
import { render, screen } from "@testing-library/react";
import { qcTaskStatus } from "./QCFormBasicDetails"; // adjust import
import { OverlayToggle } from "@cip-portal/cip-shared-ui-lib";

// Mock OverlayToggle if needed
jest.mock("@cip-portal/cip-shared-ui-lib", () => ({
  OverlayToggle: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
}));

describe("qcTaskStatus", () => {
  it("renders new status", () => {
    render(qcTaskStatus("new"));
    expect(screen.getByRole("generic", { name: "" })).toHaveAttribute("id", "new");
  });

  it("renders in progress status", () => {
    render(qcTaskStatus("in progress"));
    expect(screen.getByRole("generic", { name: "" })).toHaveAttribute("id", "inprogress");
  });

  it("renders on hold status", () => {
    render(qcTaskStatus("on hold"));
    expect(screen.getByRole("generic", { name: "" })).toHaveAttribute("id", "onhold");
  });

  it("renders completed status", () => {
    render(qcTaskStatus("completed"));
    expect(screen.getByRole("generic", { name: "" })).toHaveAttribute("id", "completed");
  });

  it("renders default case for unknown status", () => {
    render(qcTaskStatus("unknown"));
    expect(screen.getByText("unknown")).toBeInTheDocument();
  });
});
