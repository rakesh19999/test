if (!string.IsNullOrEmpty(getStudiesList.SortColumn))
{
    var sortColumn = getStudiesList.SortColumn?.ToLower();
    var sortOrder = getStudiesList.SortOrder?.ToLower();

    mergedList = sortColumn switch
    {
        "lastupdatedby" => sortOrder == "asc"
            ? mergedList
                .OrderBy(s => s.ModifiedBy == null ? 1 : 0)  // nulls last
                .ThenBy(s => s.ModifiedBy)
                .ToList()
            : mergedList
                .OrderBy(s => s.ModifiedBy == null ? 1 : 0)
                .ThenByDescending(s => s.ModifiedBy)
                .ToList(),

        "lastpublishedby" => sortOrder == "asc"
            ? mergedList
                .OrderBy(s => s.StatusName == "Published" && s.ModifiedBy != null ? 0 : 1)
                .ThenBy(s => s.StatusName == "Published" ? s.ModifiedBy : null)
                .ToList()
            : mergedList
                .OrderBy(s => s.StatusName == "Published" && s.ModifiedBy != null ? 0 : 1)
                .ThenByDescending(s => s.StatusName == "Published" ? s.ModifiedBy : null)
                .ToList(),

        _ => {
            // fallback logic using reflection as needed
            return mergedList;
        }
    };
}
