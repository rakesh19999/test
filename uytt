const checkModalityMisMatch = (studyConfig: any, pcSavedChecks: any) => {
  const modalities = studyConfig.modalities ?? [];
  const savedChecks = pcSavedChecks ?? [];

  const savedIds = new Set(savedChecks.map((check: any) => check.id));

  const missingModalities: string[] = [];

  modalities.forEach((mod: any) => {
    const isNotRequired = mod?.definedModalityRequiredStatus === 2; // NotRequired
    const modalityId = mod?.id;

    if (isNotRequired) {
      let isAnyCheckPresent = false;

      // Check if modality itself is saved
      if (savedIds.has(modalityId)) {
        isAnyCheckPresent = true;
      }

      // Loop through anatomies
      if (mod.anatomies?.length > 0) {
        for (const anatomy of mod.anatomies) {
          const anatomyId = anatomy?.definedModalityAhatomyId ?? anatomy?.id;

          if (savedIds.has(anatomyId)) {
            isAnyCheckPresent = true;
            break;
          }

          // Check image series
          if (anatomy.imageSeries?.length > 0) {
            for (const series of anatomy.imageSeries) {
              const seriesId = series?.id;

              if (savedIds.has(seriesId)) {
                isAnyCheckPresent = true;
                break;
              }
            }
          }

          if (isAnyCheckPresent) break;
        }
      }

      if (!isAnyCheckPresent) {
        missingModalities.push(mod.modality);
      }
    }
  });

  if (missingModalities.length > 0) {
    const missingString = missingModalities.join(', ');
    console.log('Missing Modality:', missingString);
    setMissingModalities(missingString);
    setShowMissingPCChecks(true);
  } else {
    setShowMissingPCChecks(false);
  }
};
