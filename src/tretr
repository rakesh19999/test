import React, { useState, useEffect } from 'react';
import { Table, Form } from 'react-bootstrap';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faMagnifyingGlass } from '@fortawesome/free-solid-svg-icons';
import '../../css/App.css';

interface ProtocolComplianceQCChecksProps {
  data: any[];
  columns: any[];
  onSelectionChange?: (selected: any[]) => void;
  checkCondition: string[];
  onAnyCheckChange: () => void;
  isPublished: boolean;
}

const ProtocolComplianceQCChecksTable: React.FC<ProtocolComplianceQCChecksProps> = ({
  data,
  columns,
  onSelectionChange,
  checkCondition,
  onAnyCheckChange,
  isPublished,
}) => {
  const [selectedRows, setSelectedRows] = useState<any[]>([]);
  const [localData, setLocalData] = useState<any[]>([]);
  const [isFieldDisabled, setIsFieldDisabled] = useState(true);
  const [search, setSearch] = useState('');
  const [userModifiedData, setUserModifiedData] = useState<any[]>([]);

  useEffect(() => {
    // Ensure data retains definedModalityQcCheckId
    const clonedData = data.map((row) => ({
      ...row,
      definedModalityQcCheckId: row.definedModalityQcCheckId || '', // ensure it's not undefined
    }));
    setLocalData(clonedData);

    // Set preselected rows with definedModalityQcCheckId
    const preselected = clonedData.filter((r) => r.isChecked && r.definedModalityQcCheckId !== '');
    setSelectedRows(preselected);
    onSelectionChange?.(preselected);
  }, [data]);

  const handleCheckBoxChange = (rowIndex: number, checked: boolean) => {
    const updatedLocalData = [...localData];
    updatedLocalData[rowIndex].isChecked = checked;

    const updatedSelection = checked
      ? [...selectedRows, updatedLocalData[rowIndex]]
      : selectedRows.filter(
          (row) => row.ImageSeriesQCCheckId !== updatedLocalData[rowIndex].ImageSeriesQCCheckId
        );

    setLocalData(updatedLocalData);
    setSelectedRows(updatedSelection);
    onSelectionChange?.(updatedSelection);
    onAnyCheckChange();
  };

  const handleConditionChange = (rowIndex: number, field: string, value: any) => {
    const updatedData = [...localData];
    updatedData[rowIndex][field] = value;

    setLocalData(updatedData);
    onAnyCheckChange();

    // Ensure definedModalityQcCheckId is updated when modifying conditions
    const updatedSelection = selectedRows.map((row) =>
      row.ImageSeriesQCCheckId === updatedData[rowIndex].ImageSeriesQCCheckId
        ? { ...row, [field]: value, definedModalityQcCheckId: updatedData[rowIndex].definedModalityQcCheckId }
        : row
    );
    setSelectedRows(updatedSelection);
    onSelectionChange?.(updatedSelection);

    // Update modified data with definedModalityQcCheckId
    const existingIndex = userModifiedData.findIndex(
      (item) => item.ImageSeriesQCCheckId === updatedData[rowIndex].ImageSeriesQCCheckId
    );
    if (existingIndex !== -1) {
      const updatedModifiedData = [...userModifiedData];
      updatedModifiedData[existingIndex] = {
        ...updatedModifiedData[existingIndex],
        [field]: value,
        definedModalityQcCheckId: updatedData[rowIndex].definedModalityQcCheckId,
      };
      setUserModifiedData(updatedModifiedData);
    } else {
      setUserModifiedData([...userModifiedData, updatedData[rowIndex]]);
    }
  };

  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value;
    setSearch(value);
    const filteredData = localData.filter(
      (item) =>
        item.diconTag.toLowerCase().includes(value.toLowerCase()) ||
        item.name.toLowerCase().includes(value.toLowerCase())
    );
    setLocalData(filteredData);
  };

  return (
    <div>
      <div className="search-box">
        <input
          type="text"
          value={search}
          onChange={handleSearchChange}
          placeholder="Search"
          disabled={isFieldDisabled}
        />
        <FontAwesomeIcon icon={faMagnifyingGlass} />
      </div>

      <div style={{ marginTop: 30, maxHeight: '400px', overflow: 'auto' }}>
        <Table className="pc-check-table">
          <thead>
            <tr>
              {columns.map((column, index) => (
                <th key={index} className="custom-table-header">
                  {column.Header}
                  {column.Header === 'Checkbox' && (
                    <Form.Check
                      type="checkbox"
                      checked={selectedRows.length === localData.length && localData.length > 0}
                      onChange={() => {
                        const newCheckedState = localData.map((row) => ({
                          ...row,
                          isChecked: !selectedRows.every((r) => r.ImageSeriesQCCheckId === row.ImageSeriesQCCheckId),
                        }));
                        setLocalData(newCheckedState);
                        setSelectedRows(newCheckedState.filter((row) => row.isChecked));
                      }}
                    />
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {localData.length === 0 ? (
              <tr>
                <td colSpan={columns.length} className="text-center">
                  No Records Available
                </td>
              </tr>
            ) : (
              localData.map((row, rowIndex) => (
                <tr key={rowIndex}>
                  {columns.map((column, columnIndex) => (
                    <td key={columnIndex} className={column.accessor === 'checkbox' ? 'checkbox-cell' : ''}>
                      {column.accessor === 'checkbox' ? (
                        <Form.Check
                          type="checkbox"
                          checked={row.isChecked || false}
                          onChange={(e) => handleCheckBoxChange(rowIndex, e.target.checked)}
                        />
                      ) : column.accessor === 'checkCondition' ? (
                        <Form.Select
                          value={row[column.accessor]}
                          onChange={(e) => handleConditionChange(rowIndex, column.accessor, e.target.value)}
                          disabled={row.isChecked || isPublished}
                        >
                          {checkCondition.map((condition, idx) => (
                            <option key={idx} value={condition}>
                              {condition}
                            </option>
                          ))}
                        </Form.Select>
                      ) : (
                        <Form.Control
                          type="text"
                          value={row[column.accessor]}
                          onChange={(e) => handleConditionChange(rowIndex, column.accessor, e.target.value)}
                          disabled={row.isChecked || isPublished}
                        />
                      )}
                    </td>
                  ))}
                </tr>
              ))
            )}
          </tbody>
        </Table>
      </div>
    </div>
  );
};

export default ProtocolComplianceQCChecksTable;
