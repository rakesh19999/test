var query = 
    from iqc in dataQCDbContext.ImageQcProtocols
    join dModQcPrt in dataQCDbContext.DefinedModalityQcProtocols on iqc.Id equals dModQcPrt.ImageQcProtocol
    join dm in dataQCDbContext.DefinedModalities on dModQcPrt.DefinedModality equals dm.Id
    join dmantm in dataQCDbContext.DefinedModalityAnatomies on dm.Id equals dmantm.DefinedModality
    join antm in dataQCDbContext.Anatomies on dmantm.Anatomy equals antm.Id
    join dis in dataQCDbContext.DefinedImageSeries on dmantm.Id equals dis.Anatomy
    join disqcprt in dataQCDbContext.DefinedImageSeriesQcProtocols on dis.Id equals disqcprt.DefinedImageSeries
    where iqc.Study == 27
    select new
    {
        DefinedModalityId = dm.Id,
        DefinedModalityName = dm.Name,
        ModalityId = dm.Modality,
        AnatomyId = antm.Id,
        AnatomyName = antm.Name,
        ImageSeriesId = dis.Id,
        ImageSeriesName = dis.Name
    };

var result = query
    .GroupBy(x => new { x.DefinedModalityId, x.DefinedModalityName, x.ModalityId })
    .Select(g => new
    {
        Id = g.Key.DefinedModalityId,
        Modality = g.Key.DefinedModalityName,
        ModalityId = g.Key.ModalityId,
        Anatomies = g.GroupBy(x => new { x.AnatomyId, x.AnatomyName })
                     .Select(a => new
                     {
                         Id = a.Key.AnatomyId,
                         Name = a.Key.AnatomyName,
                         ImageSeries = a.Select(isr => new
                         {
                             Id = isr.ImageSeriesId,
                             Name = isr.ImageSeriesName
                         }).Distinct().ToList()
                     }).ToList()
    }).ToList();
